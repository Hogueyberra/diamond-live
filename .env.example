# Public browser configuration only. Do not put a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Optional on the Mac hosting Ollama: leave blank to use the local /api/assistant proxy.
# On another computer, use the protected HTTPS endpoint from the GitHub Actions
# variable with this name. Include /api/assistant; never put credentials in the URL.
VITE_DIAMOND_ASSISTANT_URL=

# Optional Clerk sign-in. Leave BOTH blank until the server-side OAuth connection
# in docs/clerk-auth-setup.md is ready. Never put a Clerk/OAuth secret here.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SUPABASE_PROVIDER=
